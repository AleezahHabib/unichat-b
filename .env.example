# Primary Neon PostgreSQL database connection string (asyncpg driver)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.neon.tech/unichat?sslmode=require

# Test Neon PostgreSQL database connection string (MUST end in _test for safety checks)
TEST_DATABASE_URL=postgresql://user:password@ep-sample-pooler.neon.tech/unichat_test?sslmode=require

# Upstash Redis TCP/redis-py connection string
REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379

# JWT secret key for signing auth tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=replace-with-a-secure-random-48-char-secret-string

# JWT expiration time in minutes
JWT_EXPIRES_MINUTES=10080

# Fernet encryption key for encrypting platform tokens at rest (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=replace-with-a-fernet-urlsafe-base64-key

# Google Gemini API key obtained from https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Gemini OpenAI-compatible base URL endpoint
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Gemini chat completion model
CHAT_MODEL=gemini-2.5-flash

# Gemini vector embedding model
EMBEDDING_MODEL=gemini-embedding-001

# Vector embedding dimension (768 for gemini-embedding-001)
EMBEDDING_DIM=768

# AI assistant rate limit per minute
AI_REQUESTS_PER_MINUTE=8

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Enable background workers (Slack listener, Discord poller, embedding sweep)
ENABLE_BACKGROUND=true

# Discord REST polling interval in seconds
DISCORD_POLL_SECONDS=3

# Application log level
LOG_LEVEL=INFO

# Slack OAuth App Credentials & Redirect URI
SLACK_CLIENT_ID=replace-with-your-slack-client-id
SLACK_CLIENT_SECRET=replace-with-your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:8000/integrations/slack/oauth/callback
SLACK_APP_TOKEN=xapp-replace-with-your-slack-app-level-token

